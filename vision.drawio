        <mxCell id="BkcM3bNYK1mcO1Jw96N--33" value="of course, this only works well in the end IF the user behaves similarly to the TeacherAgent..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
